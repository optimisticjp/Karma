{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "karma-design-studio",
  "main": ".open-next/worker.js",
  // Must be 2025-04-01 or later so env vars/secrets auto-populate process.env.
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },

  // ---------------------------------------------------------------------
  // Hyperdrive → Supabase Postgres (the Worker's route to the database).
  //
  // NOT ENABLED YET: a Hyperdrive configuration id must be created against the
  // real Supabase connection string first, and a placeholder id here would
  // break every deploy. Until the owner supplies it, the Worker falls back to
  // the DATABASE_URL runtime secret — see docs/admin-architecture.md
  // (§ Hyperdrive) for the exact commands.
  //
  //   npx wrangler hyperdrive create karma-supabase \
  //     --connection-string="postgresql://USER:PASSWORD@HOST:5432/postgres"
  //
  // then paste the returned id below and uncomment:
  // "hyperdrive": [
  //   { "binding": "HYPERDRIVE", "id": "PASTE_THE_ID_FROM_CLOUDFLARE" }
  // ],

  // R2 bucket for confidential B2B design files (create it first:
  //   npx wrangler r2 bucket create karma-brief-files
  // then uncomment). The bucket stays PRIVATE: no public access, no
  // unauthenticated object URLs.
  // "r2_buckets": [
  //   { "binding": "BRIEF_FILES", "bucket_name": "karma-brief-files" }
  // ],

  // Non-secret runtime vars. Secrets (SUPABASE_SECRET_KEY, DATABASE_URL while
  // Hyperdrive is pending, RESEND_API_KEY, TURNSTILE_SECRET_KEY, CRON_SECRET)
  // are set with `npx wrangler secret put`. NEVER put a secret in this block.
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://karma-design-studio.essanciaonline.workers.dev",
    "STUDIO_EMAIL": "karmadesignclasses@gmail.com",
    "STUDIO_WHATSAPP": "919904376340"
  }
}
