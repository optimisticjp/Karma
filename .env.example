# ---- Database (Neon) ------------------------------------------------------
# Create a free project at https://neon.tech -> copy the pooled connection string.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# ---- Email (Resend, free tier) -------------------------------------------
# https://resend.com -> API key. Until a custom domain is verified, use
# onboarding@resend.dev as the from address.
RESEND_API_KEY=""
EMAIL_FROM="Karma Design Studio <onboarding@resend.dev>"
STUDIO_EMAIL="karmadesignclasses@gmail.com"

# ---- Spam protection (Cloudflare Turnstile, free) ------------------------
# https://dash.cloudflare.com -> Turnstile -> add site. Leave empty in dev to
# skip verification (the form logs a warning instead).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# ---- Site -----------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
STUDIO_WHATSAPP="919904376340"

# ---- Cron protection ------------------------------------------------------
# Random string; GitHub Actions sends it as a Bearer token to /api/cron/digest.
CRON_SECRET=""
