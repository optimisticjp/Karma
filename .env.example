# Copy to .env and fill in as you go. NEVER commit .env.
# Full walkthrough: docs/deployment.md · architecture: docs/admin-architecture.md

# ---- Site -----------------------------------------------------------------
# The custom domain is a LAUNCH step, not a setup step. Until the owner says
# the site is ready, this stays on the workers.dev URL.
NEXT_PUBLIC_SITE_URL="https://karma-design-studio.essanciaonline.workers.dev"
STUDIO_WHATSAPP="919904376340"

# ---- Supabase Auth --------------------------------------------------------
# https://supabase.com -> your project -> Project Settings -> API keys.
# The two NEXT_PUBLIC_ values are BUILD-time and end up in the browser bundle:
# that is fine, they are designed to be public.
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_REPLACE_ME"

# RUNTIME SECRET. Equivalent to a privileged backend credential: it bypasses
# every Supabase-side check. Never prefix it with NEXT_PUBLIC_, never put it in
# wrangler.jsonc `vars`, never log it. On Cloudflare it is set with
#   npx wrangler secret put SUPABASE_SECRET_KEY
SUPABASE_SECRET_KEY="sb_secret_REPLACE_ME"

# ---- Database -------------------------------------------------------------
# DIRECT Supabase Postgres connection, used by drizzle-kit, seeds, the backup
# script and the owner bootstrap — everything that runs OUTSIDE the Cloudflare
# request runtime. Supabase -> Project Settings -> Database -> Connection string.
#
# The deployed Worker does NOT use this: it reaches Postgres through the
# Cloudflare HYPERDRIVE binding (see wrangler.jsonc and docs/admin-architecture.md).
# A runtime DATABASE_URL is supported only as a temporary fallback while
# Hyperdrive is being set up.
DATABASE_URL="postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require"

# ---- Initial owner bootstrap ---------------------------------------------
# Read once, by `npm run admin:bootstrap`, to invite the single Owner account.
# There is no public way to create an owner. Leave blank until you run it.
INITIAL_OWNER_EMAIL=""
INITIAL_OWNER_NAME=""

# ---- Email (Resend, free tier) -------------------------------------------
# https://resend.com -> API key. Until a custom domain is verified, use
# onboarding@resend.dev as the from address.
RESEND_API_KEY=""
EMAIL_FROM="Karma Design Studio <onboarding@resend.dev>"
STUDIO_EMAIL="karmadesignclasses@gmail.com"

# ---- Spam protection (Cloudflare Turnstile, free) ------------------------
# TURNSTILE_SITE_KEY is public and may be a normal Worker variable. The client
# fetches it from /api/turnstile/config at runtime, so rotating it does not
# require rebuilding the Next.js browser bundle.
TURNSTILE_SITE_KEY=""
# Secret: set only as a Worker secret, never in wrangler.jsonc or source.
TURNSTILE_SECRET_KEY=""
# Comma-separated exact hostnames accepted from Siteverify. Never include
# localhost in production. The current workers.dev hostname is configured in
# wrangler.jsonc; add the custom domain here when launch DNS is ready.
TURNSTILE_HOSTNAMES="karma-design-studio.essanciaonline.workers.dev"

# ---- Cron protection ------------------------------------------------------
# Random string; GitHub Actions sends it as a Bearer token to /api/cron/digest.
CRON_SECRET=""

# ---- Staging only ---------------------------------------------------------
# Allows sample data and demo form responses on a non-production deploy.
# NEVER set this on the production worker.
# ALLOW_DEMO_MODE="true"
